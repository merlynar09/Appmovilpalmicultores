{
  "expo": {
    "name": "Palma Viva",
    "slug": "palma-viva",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "palmaviva",
    "android": {
      "package": "com.palmaviva.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF3E7"
      }
    },
    "ios": {
      "bundleIdentifier": "com.palmaviva.app",
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#1B4D3E"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "ec79317c-7043-43c7-b23b-fc3cf900ea9e"
      }
    },
    "owner": "merlyn09"
  }
}
