SECRET_KEY=cambia-esta-clave-en-produccion
JWT_SECRET_KEY=cambia-esta-clave-jwt
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/palma_viva

# --- Twilio (SMS real) ---
# TWILIO_ENABLED controla únicamente los envíos salientes que inicia la app
# (REST API: alertas de cosecha/logística por SMS). La respuesta a un SMS
# entrante (webhook -> TwiML) funciona en cuanto el webhook esté bien
# configurado en Twilio Console, independientemente de este flag.
# Nunca pongas el Auth Token real en este archivo .env.example (va a git).
# Tu backend/.env real NO se versiona (ver .gitignore).
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TEST_TO=
# Opcional: solo si expones el webhook por un túnel (ngrok, etc.) cuyo host
# público difiere del que Flask ve internamente.
TWILIO_WEBHOOK_BASE_URL=

# --- USSD (menú con sesión) ---
# Ver backend/docs/USSD.md para la arquitectura completa y qué proveedor
# usar en Colombia. Sin USSD_PROVIDER_SHARED_SECRET, /api/ussd/webhook
# rechaza TODAS las solicitudes (falla cerrado) — el simulador interno
# (/api/ussd/simular) no necesita esto, sigue funcionando igual.
USSD_PROVIDER_SHARED_SECRET=
USSD_PROVIDER_NOMBRE=
USSD_SESSION_TTL_SEGUNDOS=180
