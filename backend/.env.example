# FLASK_ENV=development permite que SECRET_KEY/JWT_SECRET_KEY/DATABASE_URL
# usen un valor de desarrollo si no los defines (con aviso en el log). Fuera
# de "development", son obligatorios y el backend no arranca sin ellos
# (MOD-02: nunca un secreto conocido por defecto fuera de desarrollo).
FLASK_ENV=development
SECRET_KEY=cambia-esta-clave-en-produccion
JWT_SECRET_KEY=cambia-esta-clave-jwt
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/palma_viva

# MOD-04: orígenes permitidos por CORS, separados por coma. Vacío = todo
# permitido (cómodo para desarrollo local/Expo Go/túneles que cambian de URL
# seguido). En un despliegue real, defínelo explícito, ej.:
# CORS_ORIGINS=https://tu-dominio-real.com
CORS_ORIGINS=

# MOD-05: /api/sms/entrante y /api/ussd/simular son simuladores públicos (no
# pueden exigir login — simulan a alguien sin app). Déjalo en true para
# seguir probando el simulador SMS/USSD de la app; ponlo en false para
# apagarlos en un despliegue que no los necesite.
SMS_USSD_SIMULATOR_ENABLED=true

# DEV-F2-11: seed.py exige esta confirmación antes de crear usuarios con
# contraseñas conocidas (admin123, palma123, etc.) — ver backend/seed.py.
# No la pongas en un .env de un ambiente que no sea desechable.
SEED_CONFIRM=yes

# --- Twilio (SMS real) ---
# TWILIO_ENABLED controla únicamente los envíos salientes que inicia la app
# (REST API: alertas de cosecha/logística por SMS). La respuesta a un SMS
# entrante (webhook -> TwiML) funciona en cuanto el webhook esté bien
# configurado en Twilio Console, independientemente de este flag.
# Nunca pongas el Auth Token real en este archivo .env.example (va a git).
# Tu backend/.env real NO se versiona (ver .gitignore).
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TEST_TO=
# Opcional: solo si expones el webhook por un túnel (ngrok, etc.) cuyo host
# público difiere del que Flask ve internamente.
TWILIO_WEBHOOK_BASE_URL=

# --- USSD (menú con sesión) ---
# Ver backend/docs/USSD.md para la arquitectura completa y qué proveedor
# usar en Colombia. Sin USSD_PROVIDER_SHARED_SECRET, /api/ussd/webhook
# rechaza TODAS las solicitudes (falla cerrado) — el simulador interno
# (/api/ussd/simular) no necesita esto, sigue funcionando igual.
USSD_PROVIDER_SHARED_SECRET=
USSD_PROVIDER_NOMBRE=
USSD_SESSION_TTL_SEGUNDOS=180
